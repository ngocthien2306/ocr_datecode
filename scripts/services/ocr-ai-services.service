[Unit]
Description=OCR Datecode AI Camera Management Service
After=network.target ocr-backend.service
Wants=ocr-backend.service

[Service]
Type=simple
User=demo
Group=demo
WorkingDirectory=/home/demo/Source/ocr_datecode/ai_services
Environment="PATH=/home/demo/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="CUDA_HOME=/usr/local/cuda"
Environment="LD_LIBRARY_PATH=/usr/local/cuda/lib64"
ExecStart=/usr/bin/python3 camera_management_service.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
