[Unit]
Description=OCR Datecode All Services
After=network.target mongodb.service
Wants=mongodb.service

[Service]
Type=forking
User=demo
Group=demo
WorkingDirectory=%h/Source/ocr_datecode
ExecStart=%h/Source/ocr_datecode/start_services.sh
ExecStop=%h/Source/ocr_datecode/stop_services.sh
RemainAfterExit=yes
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
