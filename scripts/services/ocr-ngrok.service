[Unit]
Description=OCR Datecode Ngrok Tunnels
After=network.target ocr-backend.service ocr-frontend.service
Wants=ocr-backend.service ocr-frontend.service

[Service]
Type=simple
User=demo
Group=demo
ExecStart=/usr/bin/ngrok start --config %h/.config/ngrok/ngrok-ocr.yml --all
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
