[Unit]
Description=OCR Datecode Frontend
After=network.target ocr-backend.service
Wants=ocr-backend.service

[Service]
Type=simple
User=demo
Group=demo
WorkingDirectory=/home/demo/Source/ocr_datecode/frontend-ts
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/yarn dev --port 5000 --host 0.0.0.0
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
