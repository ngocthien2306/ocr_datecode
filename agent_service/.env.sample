# ============================================================================
# AI Agent Service — copy sang .env rồi điền
# ============================================================================

# --- PHẢI TRÙNG với backend/.env -------------------------------------------
# Sai SECRET_KEY => mọi request trả 401 vì không verify được JWT của backend.
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=ocr_datecode_db
SECRET_KEY=
ALGORITHM=HS256

# --- Riêng của agent service ------------------------------------------------
HOST=0.0.0.0
PORT=8100

# Backend đang chạy — chỉ dùng để đọc trạng thái WebSocket của camera service
BACKEND_URL=http://localhost:8000
BACKEND_TIMEOUT=3.0

OPENAI_API_KEY=
DEFAULT_MODEL=gpt-4o-mini

# Số message lịch sử replay lại vào LLM mỗi lượt chat
MAX_HISTORY_MESSAGES=40

# Để trống = tự suy ra repo root từ vị trí file config
# PROJECT_ROOT=/home/demo/Source/ocr_datecode
