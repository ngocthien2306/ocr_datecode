# ============================================
# MongoDB — same cluster/DB as backend (shared: recipes, inference_results)
# ============================================
MONGODB_URL=mongodb://admin:password@localhost:27017/
DATABASE_NAME=ocr_datecode_db

# ============================================
# JWT — MUST match backend/.env exactly so tokens issued by backend are
# accepted here too (same SECRET_KEY/ALGORITHM, no separate login).
# ============================================
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256

# ============================================
# CORS
# ============================================
CORS_ORIGINS=["http://localhost:5173"]

# ============================================
# Application
# ============================================
APP_NAME="Anomaly Training API"
APP_VERSION="0.1.0"
DEBUG=True
PORT=8001

# ============================================
# Shared filesystem paths (same machine as backend)
# ============================================
# Root of backend/uploads — where inference_results frame images live
# (used to resolve image_path stored on inference_result docs).
BACKEND_UPLOADS_DIR=../backend/uploads
