# ============================================
# Multi-stage build for Python Backend on Jetson (Ubuntu)
# ============================================

FROM ubuntu:22.04 as base

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

# Set working directory
WORKDIR /app

# Install Python 3.10
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3.10-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Make python3.10 default
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1

# ============================================
# Dependencies Stage
# ============================================
FROM base as dependencies

# Install system dependencies including OpenCV requirements
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    # OpenCV dependencies
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    libv4l-dev \
    gfortran \
    # Additional utilities
    wget \
    && rm -rf /var/lib/apt/lists/*

# Try to install optional packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    libxvidcore-dev \
    libx264-dev \
    || true \
    && rm -rf /var/lib/apt/lists/*

# Install BLAS library (Ubuntu has better support)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libopenblas-dev \
    || apt-get install -y --no-install-recommends libatlas-base-dev \
    || true \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements files
COPY requirements.txt .
COPY requirements-jetson.txt .

# Install Python dependencies including jetson-stats
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r requirements-jetson.txt || true

# ============================================
# Production Stage
# ============================================
FROM base as production

# Set Python path
ENV PYTHONPATH=/usr/local/lib/python3.10/dist-packages:$PYTHONPATH
ENV PATH=/usr/local/bin:$PATH

# Install runtime dependencies for OpenCV (no build tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    libavcodec58 \
    libavformat58 \
    libswscale5 \
    libv4l-0 \
    && rm -rf /var/lib/apt/lists/*

# Try to install BLAS runtime library
RUN apt-get update && apt-get install -y --no-install-recommends \
    libopenblas0 \
    || apt-get install -y --no-install-recommends libatlas3-base \
    || true \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install directly (simpler approach)
COPY requirements.txt .
COPY requirements-jetson.txt .

# Install Python packages directly in production stage
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r requirements-jetson.txt || true

# Verify critical packages
RUN python -c "import uvicorn; print('✅ uvicorn version:', uvicorn.__version__)"
RUN python -c "import fastapi; print('✅ fastapi version:', fastapi.__version__)"
RUN python -c "import cv2; print('✅ OpenCV version:', cv2.__version__)"

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p /app/logs \
    /app/uploads \
    /app/uploads/inference_results \
    /app/uploads/save_frame \
    /app/uploads/templates \
    /app/uploads/visualizations \
    /app/uploads/avatar \
    /app/camera_settings \
    /app/inference_state

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8001/health')" || exit 1

# Run the application
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
