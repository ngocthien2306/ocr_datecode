# ============================================
# MongoDB Configuration
# ============================================
MONGODB_URL=mongodb://admin:password@localhost:27017/
DATABASE_NAME=ocr_datecode_db

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_RECENT=60
REDIS_CACHE_TTL_HISTORICAL=300

# ============================================
# JWT Configuration
# ============================================
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://suntech-vision.ngrok.app"]

# ============================================
# Application Configuration
# ============================================
APP_NAME="OCR Datecode API"
APP_VERSION="1.0.0"
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
TIMEZONE=Asia/Ho_Chi_Minh

# ============================================
# Storage Paths
# ============================================
BACKEND_BASE_PATH=/home/demo/Source/ocr_datecode/backend
UPLOADS_BASE_PATH=/home/demo/Source/ocr_datecode/backend/uploads
INFERENCE_RESULTS_PATH=/home/demo/Source/ocr_datecode/backend/uploads/inference_results
SAVE_FRAME_PATH=/home/demo/Source/ocr_datecode/backend/uploads/save_frame
TEMPLATE_UPLOAD_PATH=/home/demo/Source/ocr_datecode/backend/uploads/templates
TEMPLATE_VISUALIZE_PATH=/home/demo/Source/ocr_datecode/backend/uploads/visualizations
AVATAR_UPLOAD_PATH=/home/demo/Source/ocr_datecode/backend/uploads/avatar
LOGS_PATH=/home/demo/Source/ocr_datecode/backend/logs
CAMERA_SETTINGS_PATH=/home/demo/Source/ocr_datecode/backend/camera_settings
INFERENCE_STATE_PATH=/home/demo/Source/ocr_datecode/backend/inference_state

# ============================================
# AI Services Configuration
# ============================================
AI_SERVICES_PATH=/home/demo/Source/ocr_datecode/ai_services
CAMERA_SCRIPT_PATH=/home/demo/Source/ocr_datecode/ai_services/camera_shm_producer.py

# ============================================
# Image Processing
# ============================================
FRAME_SAVE_QUALITY=95

# ============================================
# Trigger Configuration
# ============================================
TRIGGER_FILE_PATH=/tmp

# ============================================
# OpenAI Configuration
# ============================================
OPENAI_API_KEY=
