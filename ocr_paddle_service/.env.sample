# ============================================
# MongoDB — same cluster/DB as backend.
# Shared read-only: recipes, inference_results, users.
# Shared with ocr_service, READ-ONLY here: ocr_projects, ocr_dataset_items.
# Owned by this service: paddle_ocr_models.
# ============================================
MONGODB_URL=mongodb://admin:password@localhost:27017/
DATABASE_NAME=ocr_datecode_db
PROJECTS_COLLECTION=ocr_projects
ITEMS_COLLECTION=ocr_dataset_items
MODELS_COLLECTION=paddle_ocr_models

# ============================================
# JWT — MUST match backend/.env exactly so tokens issued by backend's
# /api/auth/login are accepted here too. This service issues no tokens.
# ============================================
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256

# ============================================
# CORS
# ============================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://suntech-vision.ngrok.app"]

# ============================================
# Application — 8000 backend, 8001 anomaly_service, 8002 ocr_service, 8003 here.
# ============================================
APP_NAME="PaddleOCR Training API"
APP_VERSION="0.1.0"
DEBUG=True
PORT=8003

# ============================================
# Shared filesystem paths (same machine as ocr_service / ai_services)
# ============================================
# ocr_service's data dir — the labelled dataset images are read from here.
SHARED_OCR_DATA_DIR=../ocr_service/data
# Conda env with the SAME TensorRT as ai_services (engines are not portable
# across TensorRT versions). Engine build + engine eval run there as subprocesses.
TRT_CONDA_ENV=vision
