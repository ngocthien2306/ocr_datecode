+    def forward_onnx(self, x):
+        """Both heads as a plain tuple, for ONNX export.
+
+        forward() returns a dict in infer_gtc mode; torch.onnx.export flattens
+        that by key order, which is fragile to reorder. Returning the tuple
+        pins the output order the .engine's two bindings are read in
+        (gtc_logits, ctc_logits).
+        """
+        ctc_pred = self.ctc_decoder(x)
+        gtc_pred = self.gtc_decoder.forward_onnx(x.flatten(2).transpose(1, 2))
+        return gtc_pred, ctc_pred
+
 
