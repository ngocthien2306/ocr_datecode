+    def forward_onnx(self, x):
+        """forward_test without the data-dependent early exit — for ONNX export.
+
+        forward_test breaks out of the decode loop as soon as every batch
+        element has emitted <eos>. torch.onnx.export traces that condition on
+        the dummy input, so the exported graph would be frozen at however many
+        steps that one random tensor happened to need. Here the loop always
+        runs the full max_len-1 steps, giving a fixed [B, max_len-1, V] output
+        the runtime post-processor already knows how to truncate at <eos>.
+
+        Also drops the self.attn_maps bookkeeping: the exported graph has two
+        outputs (gtc_logits, ctc_logits) to match what
+        TextRecognizerSMTRTRT asserts, so per-step attention maps would be
+        dead weight in the graph.
+        """
+        if not self.ds:
+            visual_f = x + self.vis_pos_embed
+        elif self.pos2d:
+            visual_f = x + self.vis_pos_embed[:, :, :x.shape[2], :x.shape[3]]
+            visual_f = x.flatten(2).transpose(1, 2)
+        else:
+            visual_f = x
+        bs = x.shape[0]
+
+        if self.next_mode:
+            ques = self.next_token.tile([bs, 1, 1, 1]).squeeze(1)
+            prompt_embed = self.prompt_next_embed.tile([bs, 1, 1, 1]).squeeze(1)
+            bos = self.bos_next
+        else:
+            ques = self.pre_token.tile([bs, 1, 1, 1]).squeeze(1)
+            prompt_embed = self.prompt_pre_embed.tile([bs, 1, 1, 1]).squeeze(1)
+            bos = self.bos_pre
+
+        prompt_id = torch.full([bs, self.sub_str_len],
+                               bos,
+                               dtype=torch.long,
+                               device=x.device)
+        mask_pad = torch.zeros([bs, 1], dtype=torch.float32, device=x.device)
+        logits_all = []
+
+        for _ in range(0, self.max_len - 1):
+            prompt = torch.concat([
+                prompt_embed[:, :1, :],
+                prompt_embed[:, 1:, :] + self.char_embed(prompt_id)
+            ], 1)
+            mask_next = torch.where(prompt_id == bos, float('-inf'), 0)
+            mask = torch.concat([mask_pad, mask_next], 1)
+            ques_i = ques
+            for layer in self.cmff_decoder:
+                ques_i = layer(ques_i, prompt, visual_f, mask.unsqueeze(1))
+            logits = F.softmax(self.ques1_head(self.norm_pred(ques_i)), -1)
+            pred_id_i = logits.argmax(-1)
+            logits_all.append(logits)
+            if self.next_mode:
+                prompt_id = torch.concat([prompt_id[:, 1:, ], pred_id_i], 1)
+            else:
+                prompt_id = torch.concat([pred_id_i, prompt_id[:, :-1, ]], 1)
+
+        return torch.concat(logits_all, 1)
+
     def forward_train(self, x, targets=None):
         bs = x.shape[0]
 
