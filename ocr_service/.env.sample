# ============================================
# MongoDB — same cluster/DB as backend.
# Shared read-only: recipes, inference_results, users.
# Owned by this service: ocr_projects, ocr_dataset_items, ocr_models.
# ============================================
MONGODB_URL=mongodb://admin:password@localhost:27017/
DATABASE_NAME=ocr_datecode_db

# ============================================
# JWT — MUST match backend/.env exactly so tokens issued by backend's
# /api/auth/login are accepted here too. This service issues no tokens.
# ============================================
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256

# ============================================
# CORS
# ============================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://suntech-vision.ngrok.app"]

# ============================================
# Application — 8000 backend, 8001 anomaly_service, 8002 here.
# ============================================
APP_NAME="OCR Training API"
APP_VERSION="0.1.0"
DEBUG=True
PORT=8002

# ============================================
# Shared filesystem paths (same machine as backend)
# ============================================
# Root of backend/uploads — where inference_results frame images live, used to
# resolve image_path when cropping candidates out of past inspections.
BACKEND_UPLOADS_DIR=../backend/uploads
