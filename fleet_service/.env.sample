# ============================================================================
# Fleet Service — copy sang .env rồi điền
# ============================================================================

HOST=0.0.0.0
PORT=8200

# Tài khoản dùng chung để đăng nhập vào agent service của từng máy.
# Mỗi máy tự ký JWT bằng SECRET_KEY của riêng nó, nên fleet phải login RIÊNG
# từng máy — không có token dùng chung.
FLEET_EDGE_USER=admin
FLEET_EDGE_PASSWORD=

# Ghi đè cho máy có mật khẩu khác, dạng JSON: {"<node_id>": "matkhau"}
FLEET_EDGE_PASSWORD_OVERRIDES={}

# Cổng của agent service và backend trên mỗi máy
EDGE_AGENT_PORT=8100
EDGE_BACKEND_PORT=8000

# Timeout riêng cho mỗi máy. Một máy chậm không được giữ cả lượt.
EDGE_TIMEOUT=8.0
# Câu hỏi ủy quyền cho agent edge chạy lâu hơn nhiều (đo được 4–20s)
EDGE_CHAT_TIMEOUT=90.0
# Rollup: lần lạnh mổ vài trăm document fail
EDGE_ROLLUP_TIMEOUT=30.0

# Nhịp quét nền
POLL_INTERVAL=60.0
# Máy im lâu hơn ngần này thì coi là mất liên lạc
STALE_AFTER=180.0

# Đường dẫn CLI tailscale — nguồn phát hiện máy
TAILSCALE_BIN=/usr/local/bin/tailscale
